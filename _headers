/admin
  Cache-Control: no-store, no-cache, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff

/admin/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff

/api/*
  Cache-Control: no-store, no-cache, must-revalidate

/sw.js
